# /etc/superlight-uma/superlight-uma.env  (mode 0640, root:superlight-uma)
# install.sh generates UMA_ADMIN_KEY with `openssl rand -hex 32` on first install.
UMA_ADDR=127.0.0.1:8082
UMA_DB_PATH=/var/lib/superlight-uma/uma.db
UMA_ALLOWED_APPS=my-app
UMA_TRUST_PROXY=true
UMA_CORS_ORIGINS=https://*.pages.dev,http://localhost:8000
# Leave empty to make /v1/stats*, /v1/apps readable without a key (not recommended on the internet).
UMA_ADMIN_KEY=<generated>
